{
    "appId": "com.miyunadev.kiirohana",
    "productName": "Kiirohana",
    "directories": {
        "output": "build/windows"
    },
    "files": [
        "**/*"
    ],
    "build": {
        "win": {
            "target": [
                "nsis",
                "portable",
                "zip",
                "tar.gz"
            ],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "icon": "res/electron/icon.ico"
        }
    }
}