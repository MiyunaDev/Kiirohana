{
    "appId": "com.miyunadev.kiirohana",
    "productName": "Kiirohana",
    "directories": {
        "output": "release"
    },
    "files": [
        "**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electron": {
        "win": {
            "package": [
                "nsis",
                "portable",
                "zip",
                "tar.gz"
            ],
            "arch": [
                "x64", "ia32", "arm64", "armv7l"
            ],
            "icon": "res/electron/icon.ico"
        }
    }
}