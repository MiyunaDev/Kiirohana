<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<widget id="com.miyunadev.kiirohana" version="0.0.5" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Kiirohana</name>
  <description>Kiirohana Cordova Application</description>
  <author email="dev@cordova.apache.org" href="https://cordova.apache.org">&#xD;
    Miyuna Dev&#xD;
  </author>
  <content src="index.html"/>
  <preference name="scheme" value="https"/>
  <preference name="hostname" value="app.local"/>
  <access origin="*"/>
  <allow-navigation href="*"/>
  <allow-intent href="http://*/*"/>
  <allow-intent href="https://*/*"/>
  <platform name="android">
    <icon src="res/android/mipmap-mdpi/icon.png" density="mdpi"/>
    <icon src="res/android/mipmap-hdpi/icon.png" density="hdpi"/>
    <icon src="res/android/mipmap-xhdpi/icon.png" density="xhdpi"/>
    <icon src="res/android/mipmap-xxhdpi/icon.png" density="xxhdpi"/>
    <icon src="res/android/mipmap-xxxhdpi/icon.png" density="xxxhdpi"/>
    <preference name="android-usesCleartextTraffic" value="true"/>
  </platform>
  <platform name="electron">
    <preference name="ElectronSettingsFilePath" value="res/electron/settings.json"/>
  </platform>
  <icon src="res/playstore.png"/>
</widget>