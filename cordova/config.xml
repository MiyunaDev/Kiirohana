<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<widget
    id="com.miyunadev.kiirohana"
    version="0.0.5"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>Kiirohana</name>

    <description>
        Kiirohana Cordova Application
    </description>

    <author
        email="dev@cordova.apache.org"
        href="https://cordova.apache.org">
        Miyuna Dev
    </author>

    <content src="index.html"/>

    <preference name="SplashScreen" value="none" />

    <preference name="scheme" value="kiirohana"/>
    <preference name="hostname" value="localhost"/>

    <access origin="*"/>

    <allow-navigation href="http://*/*"/>
    <allow-navigation href="kiirohana://*/*"/>

    <allow-intent href="http://*/*"/>
    <allow-intent href="tel:*"/>
    <allow-intent href="mailto:*"/>

    <icon src="res/playstore.png"/>

    <platform name="android">
        <icon src="res/android/mipmap-mdpi/ic_launcher.png" density="mdpi"/>
        <icon src="res/android/mipmap-hdpi/ic_launcher.png" density="hdpi"/>
        <icon src="res/android/mipmap-xhdpi/ic_launcher.png" density="xhdpi"/>
        <icon src="res/android/mipmap-xxhdpi/ic_launcher.png" density="xxhdpi"/>
        <icon src="res/android/mipmap-xxxhdpi/ic_launcher.png" density="xxxhdpi"/>
    </platform>

    <platform name="electron">
        <preference
            name="ElectronSettingsFilePath"
            value="res/electron/settings.json"/>

        <preference
            name="ElectronBrowserWindowIcon"
            value="res/pwa/Logo Kiirohana-96.png"/>

        <icon src="res/electron/icon.png"/>
    </platform>
</widget>